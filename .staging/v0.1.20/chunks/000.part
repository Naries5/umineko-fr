effect 27,18,300,":c;Bmp\Efe\x.bmp"
effect 47,18,3000,":c;Bmp\Efe\x.bmp"
effect 67,15,300,":c;Bmp\Efe\x.bmp"

;fade from center
effect 8,18,1300,":c;Bmp\Efe\c.bmp"
effect 28,18,300,":c;Bmp\Efe\c.bmp"
effect 48,18,3000,":c;Bmp\Efe\c.bmp"
effect 68,15,300,":c;Bmp\Efe\c.bmp"
effect 88,18,1,":c;Bmp\Efe\c.bmp"

effect 9,18,1300,":c;Bmp\Efe\m1.bmp"
effect 29,18,300,":c;Bmp\Efe\m1.bmp"
