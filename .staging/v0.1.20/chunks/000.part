effect 30,18,300,":c;Bmp\Efe\1.bmp"
effect 50,18,3000,":c;Bmp\Efe\1.bmp"

effect 11,18,3000,":c;Bmp\Efe\2.bmp"
effect 31,18,300,":c;Bmp\Efe\2.bmp"

