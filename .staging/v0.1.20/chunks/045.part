mov %oldnew_bg,1 : mov $oldnew_bg_old,":b;fr_bg\orig\bmp\background\ship\ship_s2b.jpg" : mov $oldnew_bg,":b;bmp\background\ship\ship_s2bf.png" : mov $witchh12,$oldnew_bg_old : if %4095 = 0 mov $witchh12,$oldnew_bg
