;mov %play_scene,2000


;キャラの状態、コンデション、コメントの更新等は配列を使用
gosub *bt_ep4_2_def

;初期化
mov $r_txt_path,"bmp\r_click\text\txt_def.png"

csp r_clear_lsp
csp r_sprite_lsp
csp r_language_lsp
csp r_system_lsp
csp r_change_lsp

textoff
monocro off
mov %load_for_title,0
mov %r_side,1
mov %r_u_tea_flg,0
mov %r_s556_flg,0
