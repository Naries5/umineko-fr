	if ?grim[1][grim_flg] = 1 lsp grim1_lsp,r_grim1,%tmp,%tmp1 : add %tmp,91
	if ?grim[2][grim_flg] = 1 lsp grim2_lsp,r_grim2,%tmp,%tmp1 : sub %tmp,91 : add %tmp1,36
	if ?grim[3][grim_flg] = 1 lsp grim3_lsp,r_grim3,%tmp,%tmp1 : add %tmp,91
