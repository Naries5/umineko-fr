		;if %r_hyouji_cha_ma = kan && ?r[kan][condition] = 1 lsp r_change_lsp,r_change,643,508
	~

	lsp r_title_lsp,r_title,%tmp,%tmp1 : add %tmp1,36
	lsp r_exit_lsp,r_exit,%tmp,%tmp1 : add %tmp1,36

	if %r_hyouji = 0 gosub *r_cha_botann_ep4_2
	if %r_hyouji = 1 gosub *r_tips_botann_ep4_2
	if %r_hyouji = 2 gosub *r_grim_botann_ep4_2


	;中央説明テキスト
