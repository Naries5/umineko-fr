	notif %r_for_title = 1 jumpf
		;選択しているキャラのコンディションによって切り替え
		lsp r_exec_lsp,r_exec,%tmp,%tmp1 : add %tmp1,36
		lsp r_resu_lsp,r_resu,%tmp,%tmp1 : add %tmp1,36
	~

if %4095 = 0 mov $tmp2,r_innewold_old
if %4095 != 0 mov $tmp2,r_innewold
lsp r_inlang_lsp,$tmp2,250,8

