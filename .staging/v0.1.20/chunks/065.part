	~

	notif %BtnRes = r_innewold_lsp jumpf
		toggleSprites
		goto *rmenu_sai_hyouji_ep4_2
	~

	;エピソード移動ボタン（押されたボタンによって、EP１のTips、EP２のTipsを移動する）
	notif %BtnRes = r_ep1_lsp jumpf
		;各変数の初期化
		mov %r_hyouji_cha,0
		mov %r_side,0
		;mov %r_hyouji,1
		mov %r_hyouji_tips,0
		mov %tips_page,1
		mov %r_hyouji_grim,0
