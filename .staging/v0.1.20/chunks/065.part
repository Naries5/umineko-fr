	if ?grim[10][grim_flg] = 1 notif %r_hyouji_grim = 10 spbtn grim10_lsp,grim10_lsp
	if ?grim[11][grim_flg] = 1 notif %r_hyouji_grim = 11 spbtn grim11_lsp,grim11_lsp
