	~

	;キャラアイコンが押された場合、それぞれのキャラへとジャンプする
	if %r_hyouji_cha_enj = enj_eva : gosub *r_cha_eva_ep4_3        ;金蔵
	if %r_hyouji_cha_enj = enj_oko : gosub *r_cha_oko_ep4_3        ;戦人
	if %r_hyouji_cha_enj = enj_kas : gosub *r_cha_kas_ep4_3        ;真里亞
 	if %r_hyouji_cha_enj = enj_enj : gosub *r_cha_enj_ep4_3        ;源氏
