;うみねこのなく頃に
;第一話　Legend of the golden witch　仮打ち

mono 0
E_A

mov $witchh4, text002
	setLangString $witchh4, ""
bg $witchh4,22
seplay 2,25
wait 3000

;original line v
mov $witchh4, text003
	setLangString $witchh4, ""
bg $witchh4,80


mov ?grim[1][grim_flg],1
;seplay 9,1062

click

fr_bg ":b;fr_bg\orig\bmp\background\efe\black.jpg",":b;bmp\background\efe\black.png",2
wait 1000

se1 28
mov $witchh4, text001
	setLangString $witchh4, ""
bg $witchh4,1
delay 6000
fr_bg ":b;fr_bg\orig\bmp\background\efe\black.jpg",":b;bmp\background\efe\black.png",2

wait 2000

;■オープニング（後で書くよ）
;金蔵と源次、南條の会話。

fr_bg ":b;fr_bg\orig\bmp\background\mainbuilding\mlib_1ar.jpg",":b;bmp\background\mainbuilding\mlib_1ar.png",8
ld l,$NAN_DefA1,3

bgmplay 13
advchar "19"
langjp:dwave_jp 0, nan_1e1:「…………また。@:dwave_jp 0, nan_1e2:…お酒を嗜まれましたな？」\
langen:dwave_eng 0, nan_1e1:^... Encore. ^@:dwave_eng 0, nan_1e2:^... Je constate que vous avez encore bu ?^\
;＜南條


ld l,$NAN_fumuA1,80

advchar "-1"
langjp　聴診器を外しながら、年輩の医師は溜め息を漏らす。@
langen^Le vieux médecin retira son stéthoscope en soupirant.^@
br
langjp　埃と甘ったるい異臭の入り混じった薄暗い書斎に、年輩の男たちの姿はあった。\
langen^Dans la pénombre du bureau, la poussière se mêlait à une odeur douceâtre, presque écœurante. Deux hommes âgés s'y faisaient face.^\

fr_bg ":b;fr_bg\orig\bmp\background\mainbuilding\mlib_1br.jpg",":b;bmp\background\mainbuilding\mlib_1br.png",24

langjp　書斎と呼ぶにはとても広い部屋の一角には高級そうなベッドがあり、@診察を受ける男と、それを診察する医師。@そしてそれを見守る使用人のように見えた。\
langen^Dans un coin de cette pièce bien trop vaste pour n'être qu'un simple bureau,^@^ se dressait un lit luxueux. Un homme venait d'y être ausculté par le médecin penché sur lui. ^@^Un domestique veillait en silence non loin d'eux.^\

ld r,$KIN_DefA1,4

advchar "01"
langjp:dwave_jp 0, kin_1e1:「酒は我が友だ。@:dwave_jp 0, kin_1e2:お前に負けぬ友人であり、そしてお前よりも付き合いが長い。」@
langen:dwave_eng 0, kin_1e1:^L'alcool est un vieil ami. ^@:dwave_eng 0, kin_1e2:^Un ami qui n'a rien à t'envier, et que je fréquente depuis bien plus longtemps que toi.^@

;＜金蔵
br
advchar "-1"
langjp　聴診器のために胸をはだけさせていた男は、着衣の乱れを直しながら、悪びれる様子もなくそう言う。\
langen^Tout en rajustant ses vêtements après l'examen, l'homme répondit sans la moindre gêne.^\

ld l,$NAN_KomaruA3,23

advchar "19"
langjp:dwave_jp 0, nan_1e3:「…………金蔵さん。@:dwave_jp 0, nan_1e4:…あんたの体が一見調子がいいのは薬が効いてるからだ。@:dwave_jp 0, nan_1e5:だが、そんな強い酒を飲み続けては薬の意味もなくなってしまう。@:dwave_jp 0, nan_1e6:…悪いことは言わん。@:dwave_jp 0, nan_1e7:酒は控えなさい。」\
langen:dwave_eng 0, nan_1e3:^... Kinzo. ^@:dwave_eng 0, nan_1e4:^... Si vous semblez aller mieux, c'est uniquement grâce aux médicaments. ^@:dwave_eng 0, nan_1e5:^Mais à continuer de boire un alcool aussi fort, ils finiront par ne plus faire le moindre effet. ^@:dwave_eng 0, nan_1e6:^... Croyez-en mon expérience. ^@:dwave_eng 0, nan_1e7:^Vous devriez vraiment vous modérer.^\

;＜南條

ld r,$KIN_WaraiA2,80

advchar "01"
langjp:dwave_jp 0, kin_1e3:「忠告の気持ちだけはありがたくいただいておく。@:dwave_jp 0, kin_1e4:我が友よ。@:dwave_jp 0, kin_1e5:………源次。@:dwave_jp 0, kin_1e6:もう一杯頼む。@:dwave_jp 0, kin_1e7:心持ち薄めでな。@:dwave_jp 0, kin_1e8:南條の顔も立ててやれ。」\
langen:dwave_eng 0, kin_1e3:^J'entends ton conseil, ^@:dwave_eng 0, kin_1e4:^vieil ami. ^@:dwave_eng 0, kin_1e5:^... Genji, ^@:dwave_eng 0, kin_1e6:^sers-m'en un autre. ^@:dwave_eng 0, kin_1e7:^Un peu plus dilué, cette fois. ^@:dwave_eng 0, kin_1e8:^Il faut bien ménager Nanjo.^\

;＜金蔵

fr_bg ":b;fr_bg\orig\bmp\background\mainbuilding\mlib_1cr.jpg",":b;bmp\background\mainbuilding\mlib_1cr.png",0
ld c,$GEN_DefA1,24

advchar "14"
langjp:dwave_jp 0, gen_1e1:「………よろしいのですか。」\
langen:dwave_eng 0, gen_1e1:^... Êtes-vous certain de le vouloir ?^\

;＜源次


```text
advchar "-1"
langjp　源次と呼ばれた老齢の執事は、酒を求める主と、それを止める主治医の双方を見比べた後、@無言で小さく頷き、己の主の命令に忠実に従うのだった。\
langen^Genji, le vieux majordome, regarda tour à tour son maître qui réclamait de l'alcool et le médecin qui tentait de l'en dissuader.^@^ Puis il inclina légèrement la tête et, sans un mot, obéit aux ordres de Kinzo.^\

fr_bg ":b;fr_bg\orig\bmp\background\efe\black.jpg",":b;bmp\background\efe\black.png",5

langjp　彼が酒棚で準備をするのを眺めながら、主治医の南條は再fois深い溜め息を漏らす…。\
langen^Nanjo regarda Genji préparer le verre près du meuble à liqueurs et soupira à nouveau...^\

langjp　室内を満たしているその匂い。@
langen^L'odeur imprégnait toute la pièce.^@
br
langjp　…心も、そして魂も溶かしてしまうような、毒のある甘い匂いは、@主人の愛して止まないその毒々しい緑色の酒の匂いだったのだ。\
langen^... Cette douceur vénéneuse, lourde au point de sembler dissoudre le cœur autant que l'âme,^@^ venait de cette liqueur d'un vert toxique que Kinzo chérissait par-dessus tout.^\

fr_bg ":b;fr_bg\orig\bmp\background\mainbuilding\mlib_1br.jpg",":b;bmp\background\mainbuilding\mlib_1br.png",0
ld r,$KIN_DefA1,6

advchar "01"
langjp:dwave_jp 0, kin_1e9:「……南條。@:dwave_jp 0, kin_1e10:お前は私の長きに渡る親友だ。@:dwave_jp 0, kin_1e11:今日まで私を永らえさせてくれたことを、深く感謝する。」\
langen:dwave_eng 0, kin_1e9:^... Nanjo,^@:dwave_eng 0, kin_1e10:^ tu es mon plus vieil ami. ^@:dwave_eng 0, kin_1e11:^Je te dois d'être encore vivant aujourd'hui, et je t'en suis profondément reconnaissant.^\

ld l,$NAN_DefA1,23

advchar "19"
langjp:dwave_jp 0, nan_1e8:「私は何も。@:dwave_jp 0, nan_1e9:……医者としての忠告など、金蔵さんはまったく聞いてくれませんからな。」@
langen:dwave_eng 0, nan_1e8:^Je n'y suis pourtant pas pour grand-chose. ^@:dwave_eng 0, nan_1e9:^... Après tout, vous n'écoutez jamais votre cher médecin.^@

ld r,$KIN_WaraiA1,80

advchar "01"
langjp:dwave_jp 0, kin_1e12:「はっはっはっは…。@:dwave_jp 0, kin_1e13:お前とて、指し間違えた手を待てと言っても聞かぬではないか。@:dwave_jp 0, kin_1e14:ならば相子というものだろう。」\
langen:dwave_eng 0, kin_1e12:^Hahahaha... ^@:dwave_eng 0, kin_1e13:^Et toi, tu refuses toujours de reprendre un mauvais coup lorsque je t'en laisse la possibilité. ^@:dwave_eng 0, kin_1e14:^Nous voilà quittes.^\

fr_bg ":b;fr_bg\orig\bmp\background\mainbuilding\mlib_1dr.jpg",":b;bmp\background\mainbuilding\mlib_1dr.png",0
ld r,$GEN_MajimeA2,24

advchar "14"
langjp:dwave_jp 0, gen_1e2:「……お館様。」\
langen:dwave_eng 0, gen_1e2:^... Maître.^\

ld l,$KIN_WaraiA2,23

advchar "01"
langjp:dwave_jp 0, kin_1e15:「すまぬ。@:dwave_jp 0, kin_1e16:……薬は切れても死にはせんが、こいつが切れては死んでしまうでな。」\
langen:dwave_eng 0, kin_1e15:^Merci, Genji. ^@:dwave_eng 0, kin_1e16:^... Que les médicaments viennent à manquer, j'en survivrai. Mais si cette précieuse liqueur vient à manquer, ce serait autre chose.^\

advchar "-1"
langjp　諦めの表情を浮かべる南條を尻目に、金蔵は源次に差し出されたグラスを受け取る。@
langen^Sans prêter la moindre attention à l'air résigné de Nanjo, Kinzo prit le verre que Genji lui tendait.^@

br
langjp　…いっぱいに満たされたその毒々しい色を見て酒だと連想できる者は少ないだろう。\
langen^... À voir ce liquide d'une couleur presque toxique, bien peu auraient deviné qu'il s'agissait d'un alcool.^\

fr_bg ":b;fr_bg\orig\bmp\background\efe\black.jpg",":b;bmp\background\efe\black.png",22
fr_bg ":b;fr_bg\orig\bmp\background\mainbuilding\mlib_1e.jpg",":b;bmp\background\mainbuilding\mlib_1e.png",22

advchar "01"
langjp:dwave_jp 0, kin_1e17:「………南條。@:dwave_jp 0, kin_1e18:正直に話せ。@:dwave_jp 0, kin_1e19:私の命はあとどの程度持つ？」@
langen:dwave_eng 0, kin_1e17:^... Nanjo,^@:dwave_eng 0, kin_1e18:^ réponds-moi franchement. ^@:dwave_eng 0, kin_1e19:^J'en ai pour combien de temps encore ?^@

advchar "19"
langjp:dwave_jp 0, nan_1e10:「さぁて…。@:dwave_jp 0, nan_1e11:どのくらいと申し上げれば、そのお酒を控えてくれますやら。」\
