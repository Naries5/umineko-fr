mov %play_scene,32040
seplay2 9,1060,100
mov %r_hyouji_cha_ma,ma3_enj
mov %r_hyouji,0

langjp:dwave_jp 0, ber_9e254:あなたを黄金の魔女、エンジェ・ベアトリーチェだと認めるわ。@:dwave_jp 0, ber_9e255:……今こそ、あなたは本当の魔女よ。」\
langen:dwave_eng 0, ber_9e254:^ je te reconnais comme la Sorcière d'Or, ANGE Béatrice. ^@:dwave_eng 0, ber_9e255:^... À partir de maintenant, tu es une véritable sorcière.^\

advchar "-1"
langjp　彼女が私のことを魔女であると宣言した瞬間。@
langjp　…私の中で何かが大きくかわるような、そんな眩暈を感じた。\
langen^À l'instant où elle proclama que j'étais une sorcière...^@
langen^je ressentis un vertige, comme si quelque chose en moi avait radicalement changé.^\

se3 22

bg white,2

se1v 16,100
E_MA
;bgm1v 83,70
E_B
me1v 16,50

fr_bg ":b;fr_bg\orig\bmp\background\efe\black.jpg",":b;bmp\background\efe\black.png",1
;set_oldnew_bg cg_ep4_1,black,1,1


langjp　その時、バタンという音が聞こえた。@
langjp　…屋上へ通じる階段室の扉の開く音だ。@
langen^À ce moment-là, j'entendis un clac.^@
langen^... C'était le bruit de la porte donnant sur l'escalier du toit qui venait de s'ouvrir.^@

