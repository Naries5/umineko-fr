langjp:dwave_jp 0, kin_1e196:「………………ふ。@:dwave_jp 0, kin_1e197:面白いことをする。@:dwave_jp 0, kin_1e198:それでその、突きつけた条件というのは何か。」\
;＜金蔵
langen:dwave_eng 0, kin_1e196:^... Hm. ^@:dwave_eng 0, kin_1e197:^Voilà qui est intéressant. ^@:dwave_eng 0, kin_1e198:^Et quelles conditions ont-ils donc osé lui imposer ?^\
;bg Mlib_1b,0
;ld r,$KAN_DefA1,24

advchar "16"
langjp:dwave_jp 0, kan_1e36:「……はい。@:dwave_jp 0, kan_1e37:蔵臼さまは黄金の発見を問わずにその分け前として、絵羽さま、留弗夫さま、楼座さまに、計７５億円を支払うこと。@:dwave_jp 0, kan_1e38:ただしその１割を３月までに支払うこと。」\
;＜嘉音
langen:dwave_eng 0, kan_1e36:^... Oui. ^@:dwave_eng 0, kan_1e37:^Krauss versera à Eva, Rudolf et Rosa un total de sept milliards et demi de yens au titre de leurs parts, que l'or soit découvert ou non. ^@:dwave_eng 0, kan_1e38:^Toutefois, dix pour cent de cette somme devront être versés avant mars prochain.^\
fr_bg ":b;fr_bg\orig\bmp\background\mainbuilding\mlib_1a.jpg",":b;bmp\background\mainbuilding\mlib_1a.png",0
ld l,$KIN_WaraiA2,26

advchar "01"
langjp:dwave_jp 0, kin_1e199:「ふ、はっはっはっはっはっは…。@:dwave_jp 0, kin_1e200:蔵臼の間抜けめ。@:dwave_jp 0, kin_1e201:弟たちに足をさらわれるとはな。@:dwave_jp 0, kin_1e202:実に愉快ではないか。@/
langen:dwave_eng 0, kin_1e199:^Ha... Hahahahaha ! ^@:dwave_eng 0, kin_1e200:^Quel imbécile, ce Krauss ! ^@:dwave_eng 0, kin_1e201:^Se faire ainsi prendre au piège par ses propres cadets ! ^@:dwave_eng 0, kin_1e202:^Ah, voilà qui est réjouissant !^@/
ld l,$KIN_waraiA1,80

langjp:dwave_jp 0, kin_1e203:……しかし、詰めが甘いようだな？」\
langen:dwave_eng 0, kin_1e203:^ ... Mais ils ont commis une erreur, n'est-ce pas ?^\
ld r,$KAN_DefA1,23

advchar "16"
langjp:dwave_jp 0, kan_1e39:「………はい。@:dwave_jp 0, kan_1e40:蔵臼さまはそれを、絵羽さま以下お三人が緊急に大金を用立てする必要があるためと看破されました。」@
langen:dwave_eng 0, kan_1e39:^... Oui. ^@:dwave_eng 0, kan_1e40:^Krauss a compris qu'Eva et les deux autres avaient tous trois un besoin urgent d'une grosse somme d'argent.^@
ld l,$KIN_fumuA1,80

advchar "01"
langjp:dwave_jp 0, kin_1e204:「ふ。@:dwave_jp 0, kin_1e205:その程度のことは看破できるのか。@:dwave_jp 0, kin_1e206:中途半端に無能な男め。@:dwave_jp 0, kin_1e207:………今はどうしている？」\
langen:dwave_eng 0, kin_1e204:^Hm. ^@:dwave_eng 0, kin_1e205:^Il a donc au moins été capable de voir une chose aussi évidente. ^@:dwave_eng 0, kin_1e206:^Même son incompétence est incomplète ! Quel médiocre personnage ! ^@:dwave_eng 0, kin_1e207:^... Et maintenant ?^\
ld r,$KAN_KomaruA1,80

advchar "16"
langjp:dwave_jp 0, kan_1e41:「……話は一度中断されました。@:dwave_jp 0, kan_1e42:今は、ベアトリーチェさまの碑文の話をされています。」@
langen:dwave_eng 0, kan_1e41:^... La discussion a été interrompue pour le moment. ^@:dwave_eng 0, kan_1e42:^À présent, ils parlent de l'épitaphe de Béatrice.^@
ld l,$KIN_WaraiA2,80

