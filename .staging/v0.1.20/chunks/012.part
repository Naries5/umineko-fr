advchar "-1"
langjp　金蔵は老眼鏡を置くと、ふっと鼻で笑う。\
langen^Kinzo posa ses lunettes de lecture et laissa échapper un petit rire méprisant.^\
advchar "01"
langjp:dwave_jp 0, kin_1e209:「………奇跡の成就が先か、@:dwave_jp 0, kin_1e210:愚か者どもが黄金を暴くのが先か。@:dwave_jp 0, kin_1e211:…実に見物ではないか。@:dwave_jp 0, kin_1e212:……愚か者どもが我が謎を解き明かしたなら、その時は私の全ての敗北だ。@:dwave_jp 0, kin_1e213:我が屍を骨の一欠けらまでしゃぶり尽くすがいい。@:dwave_jp 0, kin_1e214:愚か者どもの貪欲さが偉大なる魔法に奇跡を宿らせるのだ。@:dwave_jp 0, kin_1e215:……だがもし！！@:dwave_jp 0, kin_1e216:　奇跡の成就が先だったなら…、/
sl
langjp:voicedelay 3680:dwave_jp 0, kin_1e217:^^先だったなら！@:dwave_jp 0, kin_1e218:　ベアトリーチェは再び蘇る！！@:dwave_jp 0, kin_1e219:　私が半生をかけて追い求めたあの微笑が蘇るのだ…！\
langen:dwave_eng 0, kin_1e209:^... Lequel viendra en premier, je me le demande. ^@:dwave_eng 0, kin_1e210:^L'accomplissement de mon miracle... ou ces imbéciles qui mettront la main sur mon or ? ^@:dwave_eng 0, kin_1e211:^Ah, voilà un spectacle auquel j'ai hâte d'assister. ^@:dwave_eng 0, kin_1e212:^Si ces idiots parviennent à résoudre mon énigme, ce sera ma défaite. Une défaite absolue ! ^@:dwave_eng 0, kin_1e213:^Qu'ils dévorent alors mon cadavre jusqu'au dernier éclat d'os ! ^@:dwave_eng 0, kin_1e214:^Oui ! Que leur cupidité nourrisse de sa force le miracle de ma grande magie ! ^@:dwave_eng 0, kin_1e215:^... Mais si... ! ^@:dwave_eng 0, kin_1e216:^Si, au contraire, mon miracle s'accomplit le premier...^@/
sl
langen:voicedelay 3680:dwave_eng 0, kin_1e217:^ S'IL S'ACCOMPLIT LE PREMIER !! ^@:dwave_eng 0, kin_1e218:^BÉATRICE RESSUSCITERA !! ^@:dwave_eng 0, kin_1e219:^Je reverrai enfin ce sourire que j'ai passé la moitié de ma vie à poursuivre... !^\
langjp:dwave_jp 0, kin_1e220:　おおぉベアトリーチェ！！@:dwave_jp 0, kin_1e221:　奇跡を賭す聖なる夜がやって来るぞ、悪魔たちとのゲームが始まるぞ…！@:dwave_jp 0, kin_1e222:　私はきっと打ち勝つ、絶対に生き残る！！@:dwave_jp 0, kin_1e223:　他のやつらの命はくれてやる！@:dwave_jp 0, kin_1e224:　富も名誉も財産も黄金も何もいらぬ！@:dwave_jp 0, kin_1e225:　ただお前の微笑みがもう一度見たいだけなのだッ！！@/
langjp:dwave_jp 0, kin_1e226:^^!s0　ゲホンゲホンゴホン！！」/
sl
langen:dwave_eng 0, kin_1e220:^ÔÔÔH, BÉATRICE !! ^@:dwave_eng 0, kin_1e221:^La nuit sacrée approche ! La nuit où tout sera misé sur un miracle ! Le jeu contre les démons va commencer ! ^@:dwave_eng 0, kin_1e222:^JE VAINCRAI ! JE SURVIVRAI, QUOI QU'IL ARRIVE !! ^@:dwave_eng 0, kin_1e223:^Qu'ils prennent la vie de tous les autres, je la leur abandonne ! ^@:dwave_eng 0, kin_1e224:^Je ne veux ni richesses, ni honneurs, ni fortune, ni or ! Je ne veux rien de tout cela !! ^@:dwave_eng 0, kin_1e225:^JE VEUX SEULEMENT REVOIR TON SOURIRE ! UNE DERNIÈRE FOIS !!^@/
langen:dwave_eng 0, kin_1e226:^^!s0^ Keuf, keuf, KOF !!^@/
quakey 2,500
quakey 2,400

mov %disable_adv_clear, 1
langjp!sd\
langen!sd\
mov %disable_adv_clear, 0
