advchar "19"
langjp:dwave_jp 0, nan_1e61:「……容態を見はするが、薬を勧めようとも入院を勧めようとも、聞き入れてくれん。@:dwave_jp 0, nan_1e62:……本当に見るだけですがな。」@
;＜南條
langen:dwave_eng 0, nan_1e61:^... Je peux surveiller son état, mais dès que je recommande un traitement ou une hospitalisation, il ne veut plus rien entendre. ^@:dwave_eng 0, nan_1e62:^... En vérité, je ne peux guère faire plus que le surveiller.^@
ld l,$HID_majimeA1,23

advchar "06"
langjp:dwave_jp 0, hid_1e115:「お医者嫌いの方もおるもんや…。@:dwave_jp 0, hid_1e116:しかし困ったもんだのお！」@
;＜秀吉
langen:dwave_eng 0, hid_1e115:^Y a vraiment des gens qui détestent les médecins à ce point... ^@:dwave_eng 0, hid_1e116:^Mais quand même... quelle galère.^@
advchar "-1"
langjp　南條が大きく溜め息をつく。@
langjp　医者の診察はその後の治療の指針とするためのものだ。@
langen^Nanjo poussa un profond soupir.^@
langen^Normalement, un examen médical sert justement à décider du traitement à suivre.^@
br
langjp　診察は受けても、その後に従わなければ何の意味もない…。
langen^S'il accepte l'examen mais refuse ensuite tout traitement, autant dire que ça ne sert à rien...^\
cl r,23
ld r,$RUD_MajimeA1,24

advchar "08"
langjp:dwave_jp 0, rud_1e124:「つまりおさらいすると。@:dwave_jp 0, rud_1e125:相変わらず余命は３ヶ月。@:dwave_jp 0, rud_1e126:瀕死のまま後どれだけ永らえるか見当も付かねぇってことだ。」@
;＜留弗夫
langen:dwave_eng 0, rud_1e124:^Donc, si je résume bien... ^@:dwave_eng 0, rud_1e125:^il lui reste encore trois mois à vivre. ^@:dwave_eng 0, rud_1e126:^Et personne sait combien de temps ce mort-vivant peut encore tenir comme ça.^@
cl l,24
ld l,$NAT_MajimeA1,23

advchar "03"
