lsp bgsp,beach_L1a,0,0,0

for %Free1 = 1 to 128
resettimer
msp bgsp,0,-2,2
waittimer 10

print 1
next
for %Free1 = 1 to 232
resettimer
msp bgsp,0,-2,0
waittimer 10
print 1
next
csp bgsp
print 2
