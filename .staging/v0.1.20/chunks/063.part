		mov %r_hyouji_tips,3
		gosub *r_tips_hyouji_ep2
		goto *rmenu_botann_saisettei_ep2
	~
	notif %BtnRes = tips4_lsp jumpf
		notif %r_hyouji_tips = 4 mov %tips_page,1
		mov %r_hyouji_tips,4
		gosub *r_tips_hyouji_ep2
		goto *rmenu_botann_saisettei_ep2
	~
	notif %BtnRes = tips5_lsp jumpf
		notif %r_hyouji_tips = 5 mov %tips_page,1
		mov %r_hyouji_tips,5
		gosub *r_tips_hyouji_ep2
		goto *rmenu_botann_saisettei_ep2
	~
	notif %BtnRes = tips6_lsp jumpf
		notif %r_hyouji_tips = 6 mov %tips_page,1
		mov %r_hyouji_tips,6
		gosub *r_tips_hyouji_ep2
		goto *rmenu_botann_saisettei_ep2
	~
