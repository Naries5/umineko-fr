csp r_clear_lsp
csp r_sprite_lsp
csp r_language_lsp
csp r_system_lsp
csp r_change_lsp

textoff
monocro off
mov %load_for_title,0
mov ?r[bea][condition],-1
mov ?r[ber][condition],-1


;チェック、コンディションの指定が各キャラごとエンド以上になっていないか確認
for %tmp = 1 to cha_kazu
	if ?r[%tmp][condition] >= ?r[%tmp][condition_end] mov ?r[%tmp][condition],?r[%tmp][condition_end]
next

textoff


