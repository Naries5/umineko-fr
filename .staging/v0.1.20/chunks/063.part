		mov %r_hyouji_tips,7
		gosub *r_tips_hyouji_ep2
		goto *rmenu_botann_saisettei_ep2
	~

	;NEXT､Backが押された場合はそのページを表示する。
	if %BtnRes = tips_next_lsp inc %tips_page : gosub *r_tips_hyouji_ep2 : goto *rmenu_botann_saisettei_ep2
	if %BtnRes = tips_back_lsp dec %tips_page : gosub *r_tips_hyouji_ep2 : goto *rmenu_botann_saisettei_ep2

;***************************************************************
	;Tipsが押された場合、Tips表示処理に飛ぶ
