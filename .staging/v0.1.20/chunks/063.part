;**************************
;煉獄の七姉妹のブレードON
*bld
	getparam %meta_tmp1,$meta_tmp2,%meta_tmp3  ;立ち絵位置（l左　C中央　ｒ右）、立ち絵、表示方法

	;画像の幅/4　で画像中心からの幅が求められるので（立ち位置のX座標からその幅を引く）
	mov %meta_tmp5,511 ;(中心座標）




	if %meta_tmp1 = l mov %metab_l_on,1
	if %meta_tmp1 = c mov %metab_c_on,1
	if %meta_tmp1 = r mov %metab_r_on,1

	
	if %meta_tmp1 = l ld l,$meta_tmp2,0
	if %meta_tmp1 = c ld c,$meta_tmp2,0
	if %meta_tmp1 = r ld r,$meta_tmp2,0

	blade_draw %meta_tmp1
	print %meta_tmp3
return

*blade_draw
	getparam %meta_tmp1 ;立ち絵位置（l左　C中央　ｒ右）

	if %is_old_sprites = 0 jumpf
	mov $witchh13, ":b;bmp\TATI\RG_blade\blade.png"
	if %meta_tmp1 = l lsp 895,$witchh13,-57,280  ;convert to widescreen
	if %meta_tmp1 = c lsp 894,$witchh13,157,280  ;convert to widescreen
	if %meta_tmp1 = r lsp 893,$witchh13,371,280  ;convert to widescreen
	~
	if %is_old_sprites = 1 jumpf
	mov $witchh13, ":b;big\bmp\TATI\RG_blade\blade.png"
	if %meta_tmp1 = l lsp 895,$witchh13,-57,0  ;convert to widescreen
	if %meta_tmp1 = c lsp 894,$witchh13,157,0  ;convert to widescreen
	if %meta_tmp1 = r lsp 893,$witchh13,371,0  ;convert to widescreen
	~


return
;------------------------------
;煉獄の七姉妹のブレードOFF
*bcl
	getparam %meta_tmp1,%meta_tmp3  ;消去立ち絵位置（l左　C中央　ｒ右　a全部）、消去方法

	;左の画像が前に来るようにする。レイヤー293左　294真ん中　295が右
	if %meta_tmp1 = l csp 895 : cl l,%meta_tmp3 : mov %metab_l_on,0
	if %meta_tmp1 = c csp 894 : cl c,%meta_tmp3 : mov %metab_c_on,0
	if %meta_tmp1 = r csp 893 : cl r,%meta_tmp3 : mov %metab_r_on,0
	if %meta_tmp1 = a csp 895 : csp 894 : csp 893 : cl a,%meta_tmp3 : mov %metab_l_on,0 : mov %metab_c_on,0 : mov %metab_r_on,0
return

*bcl_bladesonly
	csp 895
	csp 894
	csp 893
	mov %metab_l_on,0
	mov %metab_c_on,0
	mov %metab_r_on,0
return

;Uses %Free1,$Free1, %x and %y
;Init %Free1 to 1, and %x/%y to inial position before use
;Then repeatedly call this function while varying $Free1 to change the button text
;Please don't make more than 30 buttons (31-39 are text display, 40th slot reserved for background fade)
*createModTextButtonAndMoveNext
	lsp %Free1 + seventh_mod_button_first_slot, $Free1, %x, %y
	spbtn %Free1 + seventh_mod_button_first_slot, %Free1
	add %y, 26
	inc %Free1
return

*seventh_menu
mov %Free9, 0 ;indicates if adv mode was toggled. Do not use for other things in this function!
;clicking on menu buttons at this point crashes the game, so remove them.
csp r_clear_lsp
csp r_sprite_lsp
csp r_language_lsp
csp r_system_lsp

;Dim the background by loading a transparent black image
lsp seventh_mod_button_first_slot+40,":c;bmp\r_click\black.bmp",0,0,150

*seventh_menu_loop

textoff

itoa $Free1, %musicVolume
lsp seventh_mod_button_first_slot + 31, ":s#FFFFFF^~c4~Musique : " + $Free1 + " (défaut : 30)", 170, 50
itoa $Free1, %voiceVolume
lsp seventh_mod_button_first_slot + 32, ":s#FFFFFF^~c4~Voix : " + $Free1 + " (défaut : 57)", 170, 75

mov $Free1, "Non défini"
if %movieSpoilerLevel == 1 mov $Free1, "Anciennes, sans spoilers"
if %movieSpoilerLevel == 2 mov $Free1, "PS3"
lsp seventh_mod_button_first_slot + 33, ":s#FFFFFF^~c4~Vidéos : " + $Free1 + "", 170, 100

mov $Free1, "Désactivé"
if %advMode != 0 mov $Free1, "Activé"
lsp seventh_mod_button_first_slot + 34, ":s#FFFFFF^~c4~Mode ADV : " + $Free1 + "", 170, 125

mov $Free1, "Inconnue"
if %textboxType == 0 mov $Free1, "Rouge"
if %textboxType == 1 mov $Free1, "Noire (avec logo)"
if %textboxType == 2 mov $Free1, "Noire (sans logo)"
lsp seventh_mod_button_first_slot + 35, ":s#FFFFFF^~c4~Boîte ADV : " + $Free1 + "", 170, 150

lsp seventh_mod_button_first_slot + 36, ":s#FFFFFF^~c4~NB : changer les réglages ADV efface le texte à l’écran", 170, 175

mov %Free1,1
mov %x, 170
mov %y, 225

;Please don't make more than 30 buttons here
mov $Free1, ":s#C7C7C7#FFFFFF^~c4~Musique/Effets +^" : gosub *createModTextButtonAndMoveNext
mov $Free1, ":s#C7C7C7#FFFFFF^~c4~Musique/Effets -^" : gosub *createModTextButtonAndMoveNext
mov $Free1, ":s#C7C7C7#FFFFFF^~c4~Voix +^" : gosub *createModTextButtonAndMoveNext
mov $Free1, ":s#C7C7C7#FFFFFF^~c4~Voix -^" : gosub *createModTextButtonAndMoveNext
mov $Free1, ":s#C7C7C7#FFFFFF^~c4~Lire les vidéos sans spoilers^" : gosub *createModTextButtonAndMoveNext
mov $Free1, ":s#C7C7C7#FFFFFF^~c4~Lire les vidéos PS3 avec spoilers^" : gosub *createModTextButtonAndMoveNext
mov $Free1, ":s#C7C7C7#FFFFFF^~c4~Activer/désactiver le mode ADV^" : gosub *createModTextButtonAndMoveNext
mov $Free1, ":s#C7C7C7#FFFFFF^~c4~Changer la boîte de dialogue^" : gosub *createModTextButtonAndMoveNext

;If user has finished the game, add a button to unlock all achievements
if %UMINEKOEND >= 50 mov $Free1, ":s#C7C7C7#FFFFFF^~c4~Débloquer tous les succès^" : gosub *createModTextButtonAndMoveNext
if %UMINEKOEND < 50 inc %Free1

mov $Free1, ":s#C7C7C7#FFFFFF^~c4~Activer/désactiver l’ombre portée^" : gosub *createModTextButtonAndMoveNext
mov $Free1, ":s#C7C7C7#FFFFFF^~c4~Page suivante : Options FR  >>^" : gosub *createModTextButtonAndMoveNext
mov $Free1, ":s#C7C7C7#FFFFFF^~c4~Quitter^" : gosub *createModTextButtonAndMoveNext

btnwait %btnRes

if %BtnRes = -1 goto *seventh_menu_exit
if %BtnRes = -10 goto *seventh_menu_exit
if %BtnRes = 1 goto *seventh_music_plus
if %BtnRes = 2 goto *seventh_music_minus
if %BtnRes = 3 goto *seventh_voice_plus
if %BtnRes = 4 goto *seventh_voice_minus
if %BtnRes = 5 goto *seventh_old_movies
if %BtnRes = 6 goto *seventh_new_movies
if %BtnRes = 7 goto *toggle_adv
if %BtnRes = 8 goto *seventh_swap_advbox
if %BtnRes = 9 goto *seventh_unlock_achievements
if %BtnRes = 10 csp seventh_mod_button_first_slot+40 : lsp seventh_mod_button_first_slot+40,":c;bmp\r_click\white.bmp",0,0,150 : toggle_dropshadow : goto *seventh_menu_loop
if %BtnRes = 11 goto *fr_options_page2
if %BtnRes = 12 goto *seventh_menu_exit

;For all other cases, loop the menu
goto *seventh_menu_loop

; === LE SANGLOT DES GOELANDS : DEUXIEME PAGE DE REGLAGES ===
; Utilise les memes boutons et le meme fond que la page originale.
*fr_options_clear_page
mov %Free2, seventh_mod_button_first_slot + 36
for %Free1 = seventh_mod_button_first_slot + 1 to %Free2
  csp %Free1
next
return

*fr_options_page2
gosub *fr_options_clear_page
*fr_options_page2_loop
textoff
lsp seventh_mod_button_first_slot + 31, ":s#FFFFFF^~c4~Options de lecture - Page 2 / 2", 170, 70
mov $Free1,"Normale"
if %4094 == 40 mov $Free1,"Lente"
if %4094 == 15 mov $Free1,"Rapide"
if %4094 == 0 mov $Free1,"Instantanée"
lsp seventh_mod_button_first_slot + 32, ":s#FFFFFF^~c4~Vitesse actuelle : " + $Free1, 170, 110
mov %Free1,1
mov %x,170
mov %y,210
mov $Free1, ":s#C7C7C7#FFFFFF^~c4~Texte : lente^" : gosub *createModTextButtonAndMoveNext
mov $Free1, ":s#C7C7C7#FFFFFF^~c4~Texte : normale^" : gosub *createModTextButtonAndMoveNext
mov $Free1, ":s#C7C7C7#FFFFFF^~c4~Texte : rapide^" : gosub *createModTextButtonAndMoveNext
mov $Free1, ":s#C7C7C7#FFFFFF^~c4~Texte : instantanée^" : gosub *createModTextButtonAndMoveNext
mov $Free1, ":s#C7C7C7#FFFFFF^~c4~<< Page précédente^" : gosub *createModTextButtonAndMoveNext
mov $Free1, ":s#C7C7C7#FFFFFF^~c4~Quitter les options^" : gosub *createModTextButtonAndMoveNext
btnwait %BtnRes
if %BtnRes = -1 goto *seventh_menu_exit
if %BtnRes = -10 goto *seventh_menu_exit
if %BtnRes = 1 mov %4094,40 : goto *fr_options_apply_speed
if %BtnRes = 2 mov %4094,25 : goto *fr_options_apply_speed
if %BtnRes = 3 mov %4094,15 : goto *fr_options_apply_speed
if %BtnRes = 4 mov %4094,0 : goto *fr_options_apply_speed
if %BtnRes = 5 gosub *fr_options_clear_page : goto *seventh_menu_loop
if %BtnRes = 6 goto *seventh_menu_exit
goto *fr_options_page2_loop

*fr_options_apply_speed
textspeed %4094
saveglobal
goto *fr_options_page2_loop

*seventh_music_plus
add %musicVolume, 5
if %musicVolume > 70 mov %musicVolume, 70
gosub *Coll_system_helper
goto *seventh_menu_loop

*seventh_music_minus
sub %musicVolume, 5
if %musicVolume < 0   mov %musicVolume, 0
gosub *Coll_system_helper
goto *seventh_menu_loop

*seventh_voice_plus
seventh_change_voice_level 5
dwave 0, kin_1e1
goto *seventh_menu_loop

*seventh_voice_minus
seventh_change_voice_level -5
dwave 0, kin_1e1
goto *seventh_menu_loop

*seventh_old_movies
mov %movieSpoilerLevel, 1
saveglobal
goto *seventh_menu_loop

*seventh_new_movies
mov %movieSpoilerLevel, 2
saveglobal
goto *seventh_menu_loop

*toggle_adv
mov %Free9, 1
if %advMode == 0 mov %advMode, 1 : jumpf
if %advMode != 0 mov %advMode, 0 : jumpf
~
goto *seventh_menu_loop

*seventh_swap_advbox
if %textboxType == 0 mov %textboxType, 1 : jumpf
if %textboxType == 1 mov %textboxType, 2 : jumpf
if %textboxType == 2 mov %textboxType, 0 : jumpf
~
advchar $adv_char_id ;force textbox type to update immediately
goto *seventh_menu_loop

*seventh_unlock_achievements
gosub *force_set_all_achievements
goto *seventh_menu_loop

;if a jumpf is not terminated or forget to loop, will end up here
~
goto *seventh_menu_loop

*seventh_menu_exit

;Clear sprite slots 100-140, before leaving the mod menu
mov %Free2, seventh_mod_button_first_slot + 40
for %Free1 = seventh_mod_button_first_slot to %Free2
	csp %Free1
next

; Only re-init ADV mode if you're not in a NVL mode region
; If you're in a NVL mode region, this will be automatically handled when leaving the region
if %Free9 == 0 jumpf
if %adv_call_state == 0 jumpf
    gosub *clear_text_and_save_backlog
    if %advMode == 0 gosub *adv_mode_off_no_call_state
    if %advMode != 0 gosub *adv_mode_on_no_call_state
~

goto *rmenu_csutom

