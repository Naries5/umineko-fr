	if %BtnRes = geo_btn_lsp mov %r_hyouji_cha,geo : gosub *character_icon_selected_ep2        ;譲治
	if %BtnRes = rud_btn_lsp mov %r_hyouji_cha,rud : gosub *character_icon_selected_ep2        ;留弗夫
