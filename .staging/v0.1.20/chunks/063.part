		setRLangString $witchh4, "/2,0,3"
		lsp tips3_lsp,$witchh4,%tmp,%tmp1
		add %tmp1,36
	~
	notif ?tips[4][tips_flg] = 1 jumpf
		mov $witchh4, r_tips_2_4
		setRLangString $witchh4, "/2,0,3"
		lsp tips4_lsp,$witchh4,%tmp,%tmp1
		add %tmp1,36
	~
	notif ?tips[5][tips_flg] = 1 jumpf
		mov $witchh4, r_tips_2_5
		setRLangString $witchh4, "/2,0,3"
		lsp tips5_lsp,$witchh4,%tmp,%tmp1
