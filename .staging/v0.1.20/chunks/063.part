	btndef ""
	gosub *r_gazou_shokika
	csp r_bg_lsp
	csp r_black_lsp
	print 1
	texton
	if %monoflg = 1 mono 1
	if %monoflg = 2 mono 2
return ;右クリックシステムを抜ける

