gosub *bt_ep4_def

if %r_side_change = 1 lsp 0,":c;bmp\r_click\black.bmp",0,0 : wait 300 : print 10,300 : csp 0


;初期化
mov $r_txt_path,"bmp\r_click\text\txt_def.png"
mov $r_cha_back,":bc;bmp\r_click\cha_btn\cha_back.png"
mov %r_hyouji,0 ;メニュー表示（０はキャラ一覧、１はtips）

csp r_clear_lsp
csp r_sprite_lsp
csp r_language_lsp
csp r_system_lsp
csp r_change_lsp

textoff
monocro off
