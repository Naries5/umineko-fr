		if ?r[%r_hyouji_cha][condition] >= ?r[%r_hyouji_cha][condition_end]  goto *rmenu_custom_btlp_100_ep3
		if ?r[%r_hyouji_cha][condition] <= 0 goto *rmenu_custom_btlp_100_ep3
			mov %tmp,?r[%r_hyouji_cha][condition] : inc %tmp : mov ?r[%r_hyouji_cha][condition],%tmp
			seplay 9,1100

