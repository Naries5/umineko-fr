		lsp r_load_lsp,r_load,%tmp2,%tmp1 :add %tmp1,36
		lsp r_blog_lsp,r_blog,%tmp,%tmp1 : add %tmp1,36
	~

	;タイトル画面の場合は、liveボタンをつける
