*r_cha_kin_ep3

;状態、進行によってコメントを変える
if ?r[%r_hyouji_cha][condition] = 0 return
if ?r[%r_hyouji_cha][condition] = 1 mov $r_cha_tati_path,"bmp\r_click\cha_tati\ep3\kin"
if ?r[%r_hyouji_cha][condition] = 2 mov $r_cha_tati_path,"bmp\r_click\cha_tati\ep3\kin_d"

;(状態に応じたテキスト文を表示）
if ?r[%r_hyouji_cha][condition] = 0 mov $r_txt_path,"bmp\r_click\text\txt_def2.png"
if ?r[%r_hyouji_cha][condition] = 1 mov $r_txt_path,"bmp\r_click\text\cha\kin_1.png"
if ?r[%r_hyouji_cha][condition] = 2 mov $r_txt_path,"bmp\r_click\text\cha\ep3\kin_2.png"

