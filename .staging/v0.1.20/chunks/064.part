	mov %tmp,ma_bea_btn_lsp
	for %tmp2 = 1 to cha_kazu_ep3_2
		if ?r[%tmp2][condition] = -1 jumpf ;コンデション−１は完全に非表示
			lspnewold %tmp,$?r[%tmp2][?r[%tmp2][condition]],"/2,0,3",?r[%tmp2][itiran_x],?r[%tmp2][itiran_y]

