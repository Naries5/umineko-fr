	spbtn tips_back_lsp,tips_back_lsp
	spbtn grim_next_lsp,grim_next_lsp
	spbtn grim_back_lsp,grim_back_lsp

	mov %tmp,ma_bea_btn_lsp : add %tmp,cha_kazu_ep3_2
	
	mov %tmp3,1
	for %tmp2 = ma_bea_btn_lsp to %tmp
		if ?r[%tmp3][condition] >= 1 spbtn %tmp2,%tmp2
		inc %tmp3
	next

;	spbtn r_inlang_lsp,r_inlang_lsp
	spbtn r_innewold_lsp,r_innewold_lsp : spbtn r_inlang_lsp,r_inlang_lsp

	;NEXT、EP、changeのボタン化
	spbtn r_next_lsp,r_next_lsp
