;********************************************************************************
; 右クリックシステムを抜ける処理
*r_exit_ep4
	btndef ""
	gosub *r_gazou_shokika_ep4
	csp r_bg_lsp
	csp r_black_lsp
	seplay 9,1100

	print 1
	texton

	if %monoflg = 1 mono 1
	if %monoflg = 2 mono 2

return ;右クリックシステムを抜ける

