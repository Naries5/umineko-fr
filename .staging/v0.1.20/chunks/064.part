			;if %tmp2 = geo && ?r[%tmp2][condition] = 1 && ?r[%tmp2][r_ishou] = 2 lspnewold geo_btn_lsp,"bmp\r_click\cha_btn\ep2\geo_l2","/2,0,3",?r[%tmp2][itiran_x],?r[%tmp2][itiran_y]
			;if %tmp2 = kan && ?r[%tmp2][condition] = 1 && ?r[%tmp2][r_ishou] = 2 lspnewold kan_btn_lsp,"bmp\r_click\cha_btn\ep2\kan_l2","/2,0,3",?r[%tmp2][itiran_x],?r[%tmp2][itiran_y]

		~
