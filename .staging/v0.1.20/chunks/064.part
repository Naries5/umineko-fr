				if ?r[%tmp][condition] <= 0 goto *rmenu_custom_btlp_90_ep3
					mov %tmp2,?r[%tmp][condition] : inc %tmp2 : mov ?r[%tmp][condition],%tmp2
				*rmenu_custom_btlp_90_ep3
			next
