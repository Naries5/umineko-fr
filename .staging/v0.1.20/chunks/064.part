	notif %tmp = title_back_yes_lsp jumpf
		btndef ""
		csp -1
		E_A
		mov %title_skip,1
		seplay 9,18
		mov %oldnew_bg,1 : mov $oldnew_bg_old,":b;fr_bg\orig\bmp\background\efe\black.jpg" : mov $oldnew_bg,":b;bmp\background\efe\black.png" : if %4095 = 0 bg ":b;bmp\background\efe\black.png",18,3000,"bmp\r_click\efe\kannon_r.bmp" : if %4095 != 0 bg ":b;fr_bg\orig\bmp\background\efe\black.jpg",18,3000,"bmp\r_click\efe\kannon_r.bmp"
		delay 3000
		texton
		
		reset
	~

	if %tmp = title_back_no_lsp csp title_back_bg_lsp : csp title_back_yes_lsp :csp title_back_no_lsp : seplay 9,1000 : goto *rmenu_sai_hyouji_ep2_2
	if %tmp = 0 csp title_back_bg_lsp : csp title_back_yes_lsp :csp title_back_no_lsp goto *rmenu_sai_hyouji_ep2_2
	if %tmp = -1 csp title_back_bg_lsp : csp title_back_yes_lsp :csp title_back_no_lsp goto *rmenu_sai_hyouji_ep2_2
	
	
	goto *rmenu_title_back_btn_lp_ep2_2

