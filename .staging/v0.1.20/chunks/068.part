*ld_inner

	notif %is_old_sprites = 1 goto *ld_inner_postold
	mov $witchh12, ":b;"
	add $witchh12, $witchh2
	add $witchh12, ".png"
	mov $witchh10, $witchh2
	add $witchh10, ".png"

	fileexist %witchh11, $witchh10
	if %witchh11 = 1 goto *ld_inner_postold
		mov $witchh12, ":a;"
		add $witchh12, $witchh2
		add $witchh12, ".bmp"
	*ld_inner_postold

