*sl
    gosub *is_new_page_required
    if %x == 0 return

    if %disable_adv_clear == 1 jumpf

    ;If %disable_adv_clear is disabled, enable it, emit a \, then disable it
    mov %disable_adv_clear, 1
\
    mov %disable_adv_clear, 0
    return

    ;If %disable_adv_clear is already enabled, just emit a \
    ~
\
return

*noclear_cw
    mov %disable_adv_clear, 1
@/
    mov %disable_adv_clear, 0
return

*update_dropshadow
    if %dropShadow == 0 shadedistance 3,3
    if %dropShadow != 0 shadedistance 1,1
return

*toggle_dropshadow
    if %dropShadow == 0 mov %dropShadow, 1 : update_dropshadow : return
    if %dropShadow != 0 mov %dropShadow, 0 : update_dropshadow : return
return
