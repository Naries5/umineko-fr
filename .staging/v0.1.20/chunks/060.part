   ;リピートがオンになっているのならオフ、オフならオンに
	notif %bm_rpi=1 goto *bgm_mode_210

		;一曲、全曲、リピートボタンの変更
		if %bm_m = 0 vsp bgm_rpi_lsp,0 : lsp bgm_btn_rpi_lsp,$witchh7,240,442
		if %bm_m = 1 vsp bgm_rpi_lsp,0 : lsp bgm_btn_rpi_lsp,$witchh9,240,442
		if %bm_m = 2 vsp bgm_rpi_lsp,0 : lsp bgm_btn_rpi_lsp,$witchh9,240,442

