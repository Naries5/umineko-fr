	if %bm_m = 1 vsp bgm_btn_rpi_lsp,0 : lsp bgm_rpi_lsp,$witchh8,240,442
	if %bm_m = 2 vsp bgm_btn_rpi_lsp,0 : lsp bgm_rpi_lsp,$witchh8,240,442

   mov %bm_rpi,1
   vsp bgm_rpi_lsp,1 : print 1
   ;通常演奏なら、%bm_mを10に設定（BGMONCEで演奏されていた物を、BGMに変える為）
   if %bm_m = 0 mov %bm_m,10
   goto *bgm_mode_btn_lp_0
*bgm_mode_200


;順次演奏のオン、オフ
notif %BtnRes = bgm_btn_zennkyoku goto *bgm_mode_300
   ;オンならオフに、オフならオンにする
