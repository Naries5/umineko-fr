*bgm_mode_end ;エンド処理
   ;各設定の初期化
   csp -1                               ;スプライト画像の、メモリからの消去
   btndef ""                            ;ボタン画像の、メモリからの消去
                             ;立ち絵の消去
   ;setwindow 137,16,25,20,23,23,0,2,20,1,1,#999999,0,0,853,479
adv_default_text_speed_restore_window
   windoweffect 50,200
   erasetextwindow 1
   rmode 1
   mono 0
                                    ;右クリックメニューの有効化
	E_A
	seplay 9,1006
	print 1
   	cl a,1
	texton
	if %monoflg = 1 mono 1
	if %monoflg = 2 mono 2
	wait 1000
   mov %title_skip,1
reset
;goto *b_title
