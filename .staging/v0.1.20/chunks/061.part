		trap *bgm_mode_moon_1000

		lsp 510,r_black,0,0 : print 22
		lsp 510,$tmp,0,0

		lsp 508,$JES_NakuA3,0,0,128
		lsp 509,$KAN_NayamuA1,0,0,128

		tati_x_get 509,c : amsp 509,%x,0,128
		tati_x_get 508,r : amsp 508,%x,0,128

		print 6
		delay 6000
		
		*bgm_mode_moon_1000
		trap off	

		lsp 510,$tmp,0,0
		lsp 508,$JES_NakuA3,0,0,128
		lsp 509,$KAN_NayamuA1,0,0,128

		tati_x_get 509,c : amsp 509,%x,0,128
		tati_x_get 508,r : amsp 508,%x,0,128
	*bgm_mode_moon_2000

	notif %ran2 = 2 goto *bgm_mode_moon_4000
		mov $tmp,":c;"
		rnd2 %ran,1,1
		if %ran = 1 add $tmp,"bgm_mode\ss\moon1.bmp"
		
