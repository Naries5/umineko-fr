*bgm_mode_kururi
	if %bgm_mood_demo = 1 goto *demo_hyouji
	gosub *bgm_mode_k ;: print 22
	gosub *bgm_play

	mov $tmp,":c;" 
	rnd2 %ran2,1,1
	if %ran2 = 1 : add $tmp,"bgm_mode\ss\kururi1.bmp"

	trap *bgm_mode_renngoku_kururi_1000

	lsp 510,$tmp,0,0
	print 99,2000,"whirl.dll/l"
	delay 2000
	
	*bgm_mode_renngoku_kururi_1000
	trap off	

	lsp 510,$tmp,0,0

      lsp bgm_title_lsp,":s#FFFFFF^ Titre : くるり [About Face]^",%bgm_x,%bgm_y1
      lsp bgm_sakka_lsp,":s#FFFFFF^ Artiste : ｄａｉ^",%bgm_x,%bgm_y2
      lsp bgm_time_lsp,":s#FFFFFF^ Durée : 1:46^",%bgm_x,%bgm_y3
     
      gosub *bgm_mode_h2
      print 2
   gettimer %3801:sub %bm_pt,%3801 ;曲の残り時間を入力
goto *bgm_mode_btn_lp


