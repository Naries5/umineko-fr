		trap off

		lsp 510,$tmp,0,0
	~

	notif %ran = 1 jumpf
		mov $tmp,":c;" : add $tmp,sea_1A
		trap *bgm_mode_hane_2000

		;何回かに1回は船のシーンを完全再現
		lsp 510,r_white,0,0 : print 22
		lsp 510,$tmp,0,0 : print 22
	
		meplay2 2,3,100
		for %tmp = 1 to 8 : quakey 3,500 : next
		lsp 509,$but_odorokiA2,0,0 : tati_x_get 509,c : amsp 509,%x,0
		print 26
