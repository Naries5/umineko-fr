*bgm_mode_me_tokei
	if %bgm_mood_demo = 1 goto *demo_hyouji
	gosub *bgm_mode_k : print 22
	gosub *bgm_play

	mov $tmp,":c;"
	rnd2 %ran2,1,4
	if %ran2 = 1 : add $tmp,Mhal_1aN
	if %ran2 = 2 : add $tmp,Mhal_2aN
	if %ran2 = 3 : add $tmp,Mhal_2bN
	if %ran2 = 4 : add $tmp,Mhal_2cN

	;ランダムに鳴らす時計の種類を変更する。
	rnd2 %ran3,1,3
	if %ran3 = 1 : meplay2 1,11,70 : mov ?bgmm[%bm_p][bm_t],36000
	if %ran3 = 2 : meplay2 1,15,70 : mov ?bgmm[%bm_p][bm_t],42000
	if %ran3 = 3 : meplay2 1,19,70 : mov ?bgmm[%bm_p][bm_t],36000

	trap *bgm_mode_me_tokei_1000

	lsp 510,r_black,0,0 : print 22
	lsp 510,$tmp,0,0
	print 22

	delay 5000

	*bgm_mode_me_tokei_1000
	trap off	

	lsp 510,$tmp,0,0

      lsp bgm_title_lsp,":s#FFFFFF^ Titre : Ｍｅ：時計 [Clock]^",%bgm_x,%bgm_y1
      
      gosub *bgm_mode_h2
