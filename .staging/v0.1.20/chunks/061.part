		lsp 510,r_black,0,0
		lsp 509,$EV2_WaraiA1,0,0 : tati_x_get 509,c : amsp 509,%x,0
	~

	notif %ran <> 1 jumpf
		mov $tmp,":c;" 
		rnd2 %ran2,1,6
		if %ran2 = 1 : add $tmp,forest_P2a
		if %ran2 = 2 : add $tmp,forest_P2b
