	if %UMINEKOEND_FLG = 21 lsph t_btn_tea_lsp,":b/2,0,3;bmp\title\title_menu\new_tea.png",727,273  ;convert to widescreen
	if %UMINEKOEND_FLG = 22 lsph t_btn_ura_tea_lsp,":b/2,0,3;bmp\title\title_menu\new_ura_tea.png",727,309  ;convert to widescreen
	if %UMINEKOEND_TIPS_FLG = 2 lsph t_btn_tips_lsp,":b/2,0,3;bmp\title\title_menu\new_tips.png",727,345  ;convert to widescreen

