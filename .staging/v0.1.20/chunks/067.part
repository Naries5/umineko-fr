	if %UMINEKOEND >= 21 lsp t_btn_ep2_tea_lsp,":bc/2,0,3;bmp\title\title_menu\ep2_tea.png",803,223  ;convert to widescreen
	if %UMINEKOEND >= 31 lsp t_btn_ep3_tea_lsp,":bc/2,0,3;bmp\title\title_menu\ep3_tea.png",803,245  ;convert to widescreen
