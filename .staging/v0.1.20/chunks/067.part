		if %BtnRes = t_btn_ep4_tea_lsp btndef "" : mov %scenario_Number,4 : csp -1 : seplay 9,17 : bg white,10 : delay 2000 : goto *teatime_4
		if %BtnRes = 0 btndef "" : seplay 9,1001 : mov %r_for_title,1 : goto *b_title_shunkan
		if %BtnRes = -1 btndef "" : seplay 9,1001 : mov %r_for_title,1 : goto *b_title_shunkan
goto *tea_sub_menu_btn_100_loop
