*Fede_11
;変化回数を１０回に固定する、変化秒は%Fede_wait10で計算
;ウェイトタイマーは%bm_ptの変数に代入する。
mov %bm_pt,%Free9/10

mov %Free3,%Free1 + Me_v_Ch0 - 10
mov %Free12,%%Free3

;之により、Free11〜Free17までがｖｏｌ減少値10ミリ単位と成る
mov %Free22,%%Free3*10

;フェードアウト開始
for %Free19 = 1 to 10

	resettimer      ;内部タイマーをリセット

	;減少計算
	sub %Free22,%Free12
	mov %%Free3,%Free22/10
