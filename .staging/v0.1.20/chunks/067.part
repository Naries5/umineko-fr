*scenario_jump_hiduke_1986_10_4
	csp -1
	csp2 -1
	fr_bg ":b;fr_bg\orig\bmp\background\efe\black.jpg",":b;bmp\background\efe\black.png",2
	se1 29
	mov $witchh4, oct_4_1986
	setLangString $witchh4, ""
	bg $witchh4,2
	wait 1000
	fr_bg ":b;fr_bg\orig\bmp\background\efe\black.jpg",":b;bmp\background\efe\black.png",2
return

