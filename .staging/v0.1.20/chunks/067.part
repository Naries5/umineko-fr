		btnwait2 %BtnRes

		if %BtnRes = t_btn_ep1_tea_lsp btndef "" : mov %scenario_Number,1 : csp -1 : seplay 9,17 : bg white,10 : delay 2000 : goto *teatime_1
		if %BtnRes = t_btn_ep2_tea_lsp btndef "" : mov %scenario_Number,2 : csp -1 : seplay 9,17 : bg white,10 : delay 2000 : goto *teatime_2
