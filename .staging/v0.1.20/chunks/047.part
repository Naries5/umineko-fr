;＜紗音

ld c,$KAN_FumanA2,23

advchar "16"
langjp:dwave_jp 0, kan_4e8:「…………姉さんは馬鹿だな。@:dwave_jp 0, kan_4e9:この地下牢は、食堂に比べて狭過ぎる。」\
langen:dwave_eng 0, kan_4e8:^... Réfléchis un peu, grande sœur. ^@:dwave_eng 0, kan_4e9:^Cette cellule est beaucoup trop petite comparée à la salle à manger.^\
;＜嘉音


ld l,$KIR_majimeA2,80

advchar "09"
langjp:dwave_jp 0, kir_4e168:「その通り。@:dwave_jp 0, kir_4e169:１番目に落とされたのは蔵臼兄さん。@:dwave_jp 0, kir_4e170:２番目が私。@:dwave_jp 0, kir_4e171:蔵臼兄さんはこの部屋に落ちてきた時、その場を動いたかしら？」\
langen:dwave_eng 0, kir_4e168:^Exactement. ^@:dwave_eng 0, kir_4e169:^Krauss a été le premier à tomber. ^@:dwave_eng 0, kir_4e170:^Je l'ai suivi juste après. ^@:dwave_eng 0, kir_4e171:^Krauss, lorsque vous êtes arrivé ici, vous êtes-vous déplacé avant que les autres ne tombent ?^\
;＜霧江

