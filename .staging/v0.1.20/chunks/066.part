if %scenario_Number = 3 mov $%Free2,"^Ep3: " : add $%Free2,$SaveTime
if %scenario_Number = 4 mov $%Free2,"^Ep4: " : add $%Free2,$SaveTime
 


;セーブデータ作成時のコメント取得
