ld l,$JES_DefA1,23

advchar "04"
langjp:dwave_jp 0, jes_1e109:「へへ、年季の入ったボロ屋敷よりこっちの方が好評みてぇだしな。@:dwave_jp 0, jes_1e110:私も自分の部屋をこっちに持ちたいぜ。」@

;＜朱志香

langen:dwave_eng 0, jes_1e109:^Héhé ! Et crois-moi, personne va s'en plaindre ! À côté, le vieux manoir fait carrément antiquité ! ^@:dwave_eng 0, jes_1e110:^Sérieux, moi aussi, j'veux une chambre ici ! C'est pas juste que seuls les invités en profitent !^@

