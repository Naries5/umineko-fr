langen:dwave_eng 0, nat_1e20:^Cela faisait bien longtemps, Battler. ^@:dwave_eng 0, nat_1e21:^Comme tu as grandi...^@

ld l,$BUT_waraiA1,23



advchar "10"
langjp:dwave_jp 0, but_1e334:「え、ぁ、はい！@:dwave_jp 0, but_1e335:　食ったり食べたり食事したりしてたらいつの間にかこんな身長に。」\

langen:dwave_eng 0, but_1e334:^Hein ? Ah, oui ! Ahaha ! ^@:dwave_eng 0, but_1e335:^Vous connaissez mon secret ? J'ai mangé, j'ai dormi, j'ai remangé... Et paf ! Me voilà avec une tête de plus !^\

ld r,$NAT_WaraiA1,80



